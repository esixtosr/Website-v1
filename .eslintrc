{
  "root": true,
  "extends": "@upstatement/eslint-config/react",
  "parser": "@babel/eslint-parser",
  "parserOptions": {
    "requireConfigFile": false,
    "babelOptions": {
      "presets": ["@babel/preset-react", "babel-preset-gatsby"]
    }
  },
  "settings": {
    "react": {
      "version": "detect"
    }
  }
}
